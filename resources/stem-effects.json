{
  "version": 1,
  "description": "Dedicated Image-Line stock-effect instances for native cutoff and mixer-slot Mix automation. Plugin states are exact factory records; no musical material or third-party plugin state is packaged.",
  "semantics": {
    "neutral": "Blend effects initialize slot Mix at zero. Native low-pass cutoff initializes fully open at knob 100%, with slot Mix 100% and no resonance.",
    "full_blend": "Mix 100% selects the effect output including any dry signal inside the preset; it does not guarantee 100% internally wet.",
    "filter": "lowpass_cutoff_percent moves the real cutoff knob at native parameter offset 0x8000. Values are knob position, not Hz. Legacy lowpass_blend_percent and highpass_blend_percent crossfade into fixed resonant factory sounds.",
    "state_preservation": "Only the wrapper destination and visible-editor bit change during cloning. The event 213 bytes remain exact.",
    "validation": "Binary layout and native factory examples were inspected. Loading and listening in FL Studio have not been verified for generated output."
  },
